{
  "name": "backend",
  "version": "1.0.0",
  "description": "Sweepro backend API",
  "main": "src/index.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "worker": "node src/workers/assignmentWorker.js",
    "worker:dev": "nodemon src/workers/assignmentWorker.js",
    "worker:notifications": "node src/workers/notificationWorker.js",
    "worker:outbox": "node src/workers/outboxDispatcherWorker.js",
    "reassign-worker": "node src/workers/adminReassignWorker.js",
    "reassign-worker:dev": "nodemon src/workers/adminReassignWorker.js",
    "cron": "node src/cron/cronManager.js",
    "cron:dev": "nodemon src/cron/cronManager.js",
    "build": "npm run prisma:generate",
    "test": "cross-env NODE_ENV=test jest --detectOpenHandles",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:assignment": "node src/scripts/test-auto-assignment.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^5.12.0",
    "@bull-board/express": "^5.12.0",
    "@prisma/client": "^6.8.2",
    "@sendgrid/mail": "^8.1.5",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.61.0",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "firebase-admin": "^13.6.0",
    "html5-qrcode": "^2.3.8",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1",
    "node-cron": "^4.2.1",
    "prisma": "^6.8.2",
    "razorpay": "^2.9.6",
    "react-toastify": "^11.0.5",
    "resend": "^3.0.0",
    "short-uuid": "^5.2.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "dotenv/config"
    ]
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
