NODE_ENV=production
TZ=UTC

# Core services
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379

# API
PORT=3000
CORS_ORIGIN=
FRONTEND_URL=
JWT_SECRET=

# Admin Authentication (Required in production)
ADMIN_EMAIL=admin@sweepro.com
ADMIN_PASSWORD=your-strong-password-here-123!@#
ADMIN_NAME=Admin User
ADMIN_PHONE=9876543210

# Admin Security (Optional)
ALLOWED_ADMIN_IPS=127.0.0.1,10.0.0.1

# Razorpay (test/production as applicable)
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_PRIVATE_KEY_BASE64=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PROJECT_ID=

# Email (SMTP)
FROM_EMAIL=
FROM_NAME=
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_SECURE=false

# App constraints
ASSIGNMENT_REQUEST_HOURS_BEFORE=20
WORKER_CONCURRENCY=5