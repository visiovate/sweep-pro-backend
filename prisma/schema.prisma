generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  password            String
  role                UserRole         @default(CUSTOMER)
  name                String
  phone               String           @unique
  address             String?
  latitude            Float?
  longitude           Float?
  status              UserStatus       @default(ACTIVE)
  timeSlot            String?
  profileImage        String?
  languagePreferences String[]         @default([])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  adminProfile        AdminProfile?
  customerBookings    Booking[]        @relation("CustomerBookings")
  maidBookings        Booking[]        @relation("MaidBookings")
  customerProfile     CustomerProfile?
  feedbacks           Feedback[]
  reportedIssues      Issue[]          @relation("ReportedIssues")
  resolvedIssues      Issue[]          @relation("ResolvedIssues")
  maidProfile         MaidProfile?
  notifications       Notification[]
  payments            Payment[]        @relation("CustomerPayments")

  @@index([email])
  @@index([phone])
  @@index([role])
}

model CustomerProfile {
  id                  String              @id @default(uuid())
  userId              String              @unique
  preferences         Json?
  emergencyContact    String?
  specialInstructions String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription        Subscription?
  taskCustomizations  TaskCustomization[]
}

model MaidProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  skills             String[]
  languages          String[]
  availability       Json
  rating             Float               @default(0)
  totalRatings       Int                 @default(0)
  status             MaidStatus          @default(PENDING_VERIFICATION)
  isFloatingMaid     Boolean             @default(false)
  maxDailyBookings   Int                 @default(3)
  serviceRadius      Float               @default(2.0)
  currentLatitude    Float?
  currentLongitude   Float?
  lastLocationUpdate DateTime?
  completedBookings  Int                 @default(0)
  cancelledBookings  Int                 @default(0)
  attendanceStreak   Int                 @default(0)
  performanceScore   Float               @default(0)
  hourlyRate         Float?
  commissionRate     Float               @default(0.15)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attendance         Attendance[]
  locationHistory    LocationHistory[]
  documents          MaidDocument[]
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  zones              MaidZone[]
  performanceMetrics PerformanceMetric[]

  @@index([status])
  @@index([isFloatingMaid])
  @@index([rating])
}

model Zone {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  boundaries  Json
  isActive    Boolean    @default(true)
  maxMaids    Int        @default(10)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  bookings    Booking[]
  maidZones   MaidZone[]

  @@index([name])
}

model MaidZone {
  id        String      @id @default(uuid())
  maidId    String
  zoneId    String
  isPrimary Boolean     @default(false)
  createdAt DateTime    @default(now())
  maid      MaidProfile @relation(fields: [maidId], references: [id], onDelete: Cascade)
  zone      Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([maidId, zoneId])
  @@index([maidId])
  @@index([zoneId])
}

model Service {
  id                    String          @id @default(uuid())
  name                  String
  description           String
  category              ServiceCategory
  baseDuration          Int
  basePrice             Float
  isActive              Boolean         @default(true)
  bufferTime            Int             @default(30)
  maxDailyBookings      Int             @default(50)
  isSubscriptionService Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  bookings              Booking[]
  servicePlans          ServicePlan[]
  tasks                 Task[]

  @@index([category])
  @@index([isActive])
  @@index([isSubscriptionService])
}

model Task {
  id                    String              @id @default(uuid())
  serviceId             String
  name                  String
  description           String
  estimatedDuration     Int
  isRequired            Boolean             @default(true)
  order                 Int                 @default(0)
  checklist             Json
  instructionsMultiLang Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  service               Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  taskCompletions       TaskCompletion[]
  taskCustomizations    TaskCustomization[]

  @@index([serviceId])
  @@index([order])
}

model TaskCustomization {
  id            String          @id @default(uuid())
  customerId    String
  taskId        String
  modifications Json
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  customer      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  task          Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([customerId, taskId])
  @@index([customerId])
}

model Booking {
  id                  String              @id @default(uuid())
  customerId          String
  maidId              String?
  serviceId           String
  zoneId              String?
  status              BookingStatus       @default(PENDING)
  priority            BookingPriority     @default(NORMAL)
  scheduledAt         DateTime
  timeSlot            String?             // Customer's preferred time slot (e.g., "09:00-12:00")
  estimatedDuration   Int
  actualStartTime     DateTime?
  actualEndTime       DateTime?
  completedAt         DateTime?
  serviceAddress      String
  serviceLatitude     Float?
  serviceLongitude    Float?
  totalAmount         Float
  discount            Float               @default(0)
  finalAmount         Float
  specialInstructions String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  customer            User                @relation("CustomerBookings", fields: [customerId], references: [id])
  maid                User?               @relation("MaidBookings", fields: [maidId], references: [id])
  service             Service             @relation(fields: [serviceId], references: [id])
  zone                Zone?               @relation(fields: [zoneId], references: [id])
  feedback            Feedback?
  issues              Issue[]
  payment             Payment?
  rescheduleHistory   RescheduleHistory[]
  serviceOTP          ServiceOTP?
  taskCompletions     TaskCompletion[]

  @@index([customerId])
  @@index([maidId])
  @@index([serviceId])
  @@index([status])
  @@index([scheduledAt])
  @@index([zoneId])
}

model RescheduleHistory {
  id          String   @id @default(uuid())
  bookingId   String
  oldDateTime DateTime
  newDateTime DateTime
  reason      String
  requestedBy String
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model TaskCompletion {
  id                 String             @id @default(uuid())
  bookingId          String
  taskId             String
  status             TaskStatus         @default(PENDING)
  completedAt        DateTime?
  notes              String?
  proofImages        String[]           @default([])
  timeSpent          Int?
  customerOtp        String?
  otpSentAt          DateTime?
  otpVerifiedAt      DateTime?
  customerVerified   Boolean            @default(false)
  verificationMethod VerificationMethod @default(PHOTO)
  customerSignature  String?
  proximityVerified  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  booking            Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  task               Task               @relation(fields: [taskId], references: [id])

  @@unique([bookingId, taskId])
  @@index([bookingId])
  @@index([taskId])
}

model Feedback {
  id                String    @id @default(uuid())
  bookingId         String    @unique
  customerId        String
  overallRating     Int
  qualityRating     Int?
  punctualityRating Int?
  behaviorRating    Int?
  comment           String?
  improvements      String?
  wouldRecommend    Boolean?
  adminResponse     String?
  adminResponseAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer          User      @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([overallRating])
}

model Payment {
  id              String        @id @default(uuid())
  bookingId       String?       @unique
  subscriptionId  String?
  customerId      String
  amount          Float
  discount        Float         @default(0)
  tax             Float         @default(0)
  finalAmount     Float
  status          PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod
  gateway         String?
  transactionId   String?
  gatewayResponse Json?
  paymentType     PaymentType   @default(BOOKING)
  refundAmount    Float?
  refundReason    String?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer        User          @relation("CustomerPayments", fields: [customerId], references: [id])
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([transactionId])
  @@index([subscriptionId])
}

model Subscription {
  id           String             @id @default(uuid())
  customerId   String             @unique
  planId       String
  status       SubscriptionStatus @default(PENDING_PAYMENT)
  startDate    DateTime
  endDate      DateTime
  billingCycle BillingCycle       @default(MONTHLY)
  amount       Float
  discount     Float              @default(0)
  autoRenew    Boolean            @default(true)
  nextBillDate DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  payments     Payment[]
  customer     CustomerProfile    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan         ServicePlan        @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([endDate])
}

model ServicePlan {
  id               String         @id @default(uuid())
  name             String         @unique
  description      String
  serviceId        String
  sessionsPerWeek  Int
  sessionsPerMonth Int
  duration         Int
  basePrice        Float
  discountPercent  Float          @default(0)
  finalPrice       Float
  isActive         Boolean        @default(true)
  isPopular        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  service          Service        @relation(fields: [serviceId], references: [id])
  subscriptions    Subscription[]

  @@index([serviceId])
  @@index([isActive])
}

model MaidDocument {
  id             String       @id @default(uuid())
  maidId         String
  type           DocumentType
  documentNumber String?
  url            String
  verified       Boolean      @default(false)
  verifiedBy     String?
  verifiedAt     DateTime?
  expiryDate     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  maid           MaidProfile  @relation(fields: [maidId], references: [id], onDelete: Cascade)

  @@index([maidId])
  @@index([type])
  @@index([verified])
}

model Attendance {
  id               String           @id @default(uuid())
  maidId           String
  date             DateTime         @db.Date
  checkIn          DateTime?
  checkOut         DateTime?
  checkInLocation  Json?
  checkOutLocation Json?
  status           AttendanceStatus @default(PRESENT)
  hoursWorked      Float?
  overtime         Float?           @default(0)
  adminAdjusted    Boolean          @default(false)
  adminNotes       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  maid             MaidProfile      @relation(fields: [maidId], references: [id], onDelete: Cascade)

  @@unique([maidId, date])
  @@index([maidId])
  @@index([date])
  @@index([status])
}

model PerformanceMetric {
  id                String      @id @default(uuid())
  maidId            String
  month             Int
  year              Int
  totalBookings     Int         @default(0)
  completedBookings Int         @default(0)
  cancelledBookings Int         @default(0)
  averageRating     Float       @default(0)
  onTimePercentage  Float       @default(0)
  customerRetention Float       @default(0)
  qualityScore      Float       @default(0)
  reliabilityScore  Float       @default(0)
  overallScore      Float       @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  maid              MaidProfile @relation(fields: [maidId], references: [id], onDelete: Cascade)

  @@unique([maidId, month, year])
  @@index([maidId])
  @@index([year, month])
}

model LocationHistory {
  id        String           @id @default(uuid())
  maidId    String
  latitude  Float
  longitude Float
  accuracy  Float?
  timestamp DateTime         @default(now())
  bookingId String?
  activity  LocationActivity @default(GENERAL)
  maid      MaidProfile      @relation(fields: [maidId], references: [id], onDelete: Cascade)

  @@index([maidId])
  @@index([timestamp])
  @@index([bookingId])
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  type         NotificationType
  title        String
  message      String
  data         Json?
  read         Boolean          @default(false)
  readAt       DateTime?
  delivered    Boolean          @default(false)
  deliveredAt  DateTime?
  scheduledFor DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([read])
  @@index([scheduledFor])
}

model AdminProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  permissions Json
  department  String?
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Issue {
  id          String        @id @default(uuid())
  bookingId   String
  reportedBy  String
  type        IssueType
  category    IssueCategory
  priority    IssuePriority @default(MEDIUM)
  status      IssueStatus   @default(OPEN)
  title       String
  description String
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  escalatedAt DateTime?
  escalatedTo String?
  attachments String[]      @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  booking     Booking       @relation(fields: [bookingId], references: [id])
  reporter    User          @relation("ReportedIssues", fields: [reportedBy], references: [id])
  resolver    User?         @relation("ResolvedIssues", fields: [resolvedBy], references: [id])

  @@index([bookingId])
  @@index([reportedBy])
  @@index([resolvedBy])
  @@index([status])
  @@index([priority])
}

model SystemConfig {
  id          String     @id @default(uuid())
  key         String     @unique
  value       String
  type        ConfigType @default(STRING)
  description String?
  updatedBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([key])
}

model ServiceOTP {
  id                  String    @id @default(uuid())
  bookingId           String    @unique
  startOTP            String?
  endOTP              String?
  startOTPGeneratedAt DateTime?
  endOTPGeneratedAt   DateTime?
  startOTPVerifiedAt  DateTime?
  endOTPVerifiedAt    DateTime?
  startVerified       Boolean   @default(false)
  endVerified         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  booking             Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

enum UserRole {
  CUSTOMER
  MAID
  FLOATING_MAID
  ADMIN
  SUPERVISOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLACKLISTED
  PENDING_VERIFICATION
}

enum MaidStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
  BLACKLISTED
  ON_LEAVE
}

enum ServiceCategory {
  CLEANING
  DEEP_CLEANING
  MAINTENANCE
  SPECIAL_EVENT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum BookingPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum VerificationMethod {
  PHOTO
  VIDEO
  OTP
  SIGNATURE
  PROXIMITY
  CUSTOMER_CONFIRMATION
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  ISSUE_REPORTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  WALLET
  CASH
  BANK_TRANSFER
}

enum PaymentType {
  BOOKING
  SUBSCRIPTION
  RENEWAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  SUSPENDED
  PENDING_PAYMENT
}

enum BillingCycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum DocumentType {
  AADHAR_CARD
  PAN_CARD
  VOTER_ID
  DRIVING_LICENSE
  PASSPORT
  ADDRESS_PROOF
  POLICE_VERIFICATION
  MEDICAL_CERTIFICATE
  BANK_ACCOUNT_PROOF
  PHOTO
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  SICK_LEAVE
}

enum LocationActivity {
  GENERAL
  TRAVELING_TO_CUSTOMER
  AT_CUSTOMER_LOCATION
  TRAVELING_BETWEEN_CUSTOMERS
  BREAK
  END_OF_DAY
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  BOOKING_CANCELLED
  MAID_ASSIGNED
  SERVICE_ASSIGNED
  MAID_ARRIVED
  SERVICE_STARTED
  SERVICE_COMPLETED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  FEEDBACK_REQUEST
  PROMOTION
  SYSTEM_ALERT
  ATTENDANCE_ALERT
  PERFORMANCE_ALERT
}

enum IssueType {
  SERVICE_QUALITY
  MAID_BEHAVIOR
  TIMING_ISSUE
  PAYMENT_ISSUE
  TECHNICAL_ISSUE
  SAFETY_CONCERN
  DAMAGE_CLAIM
  OTHER
}

enum IssueCategory {
  CUSTOMER_COMPLAINT
  MAID_COMPLAINT
  SYSTEM_ISSUE
  BILLING_ISSUE
  SAFETY_INCIDENT
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  ESCALATED
}

enum ConfigType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}
