        {
          "name": "Get User Dashboard Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success) {",
                  "        console.log('✅ User dashboard data retrieved');",
                  "        console.log('Dashboard sections available:', Object.keys(response.data));",
                  "        if (response.data.subscriptionStatus) {",
                  "            console.log('Has active subscription:', response.data.subscriptionStatus.hasActiveSubscription);",
                  "        }",
                  "        if (response.data.upcomingServices) {",
                  "            console.log('Upcoming services:', response.data.upcomingServices.length);",
                  "        }",
                  "        if (response.data.bufferInfo) {",
                  "            console.log('Buffer days remaining:', response.data.bufferInfo.remaining);",
                  "        }",
                  "    }",
                  "} else {",
