		{
			"name": "2. Customer Buffer APIs",
			"item": [
				{
					"name": "Get Monthly Subscription Status",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success && response.data) {",
									"        console.log('✅ Monthly subscription status retrieved');",
									"        console.log('Has active subscription:', response.data.hasActiveSubscription);",
									"        if (response.data.subscription) {",
									"            pm.collectionVariables.set('subscription_id', response.data.subscription.id);",
									"            console.log('Subscription ID:', response.data.subscription.id);",
									"            console.log('Plan:', response.data.subscription.plan?.name);",
									"            console.log('Status:', response.data.subscription.status);",
									"            console.log('Buffer days count:', response.data.subscription.bufferDaysCount);",
									"            console.log('Buffer days used:', response.data.subscription.bufferDaysUsed);",
									"        }",
									"    }",
									"} else {",
									"    console.log('❌ Failed to get subscription status');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/subscriptions/monthly-status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"subscriptions",
								"monthly-status"
							]
						}
					}
				},
				{
					"name": "Get Remaining Buffer Days",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success) {",
									"        console.log('✅ Buffer days info retrieved');",
									"        console.log('Total buffer days:', response.data.total);",
									"        console.log('Used buffer days:', response.data.used);",
									"        console.log('Remaining buffer days:', response.data.remaining);",
									"        console.log('Reset date:', response.data.resetDate);",
									"    }",
									"} else {",
									"    console.log('❌ Failed to get buffer days info');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/buffer/remaining/{{subscription_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"buffer",
								"remaining",
								"{{subscription_id}}"
							]
						}
					}
				},
				{
					"name": "Request Buffer Days (3 days)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.success) {",
									"        console.log('✅ Buffer period requested successfully');",
									"        if (response.data.bufferPeriod) {",
									"            pm.collectionVariables.set('buffer_period_id', response.data.bufferPeriod.id);",
									"            console.log('Buffer period ID:', response.data.bufferPeriod.id);",
									"            console.log('Status:', response.data.bufferPeriod.status);",
									"            console.log('Start date:', response.data.bufferPeriod.startDate);",
									"            console.log('End date:', response.data.bufferPeriod.endDate);",
									"        }",
									"        console.log('Message:', response.data.message);",
									"    }",
									"} else {",
									"    console.log('❌ Failed to request buffer period');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"daysCount\": 3,\n    \"startDate\": \"2025-01-15\",\n    \"reason\": \"Going on vacation\",\n    \"notes\": \"Will be traveling abroad for 3 days, please pause services\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/buffer/request/{{subscription_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"buffer",
								"request",
								"{{subscription_id}}"
							]
						}
					}
				},
				{
					"name": "Get Buffer Period History",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.success) {",
									"        console.log('✅ Buffer history retrieved');",
									"        console.log('Total records:', response.data.history.length);",
									"        response.data.history.forEach((buffer, index) => {",
									"            console.log(`Buffer ${index + 1}:`);",
									"            console.log('  Status:', buffer.status);",
									"            console.log('  Reason:', buffer.reason);",
									"            console.log('  Days:', buffer.daysCount);",
									"            console.log('  Period:', buffer.startDate, 'to', buffer.endDate);",
									"        });",
									"    }",
									"} else {",
									"    console.log('❌ Failed to get buffer history');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/buffer/history/{{subscription_id}}?page=1&limit=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"buffer",
								"history",
								"{{subscription_id}}"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						}
					}
				}
